RewriteEngine On

# Preserva a validação do certificado SSL
RewriteRule ^\.well-known(?:/|$) - [L]

# Retira /site/ dos endereços antigos
RewriteCond %{THE_REQUEST} \s/+site(?:[/?\s]) [NC]
RewriteRule ^site/?(.*)$ /$1 [R=302,L]

# Abre a página inicial sem index.html
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ / [R=302,L]

# Retira .html dos endereços acessados
RewriteCond %{THE_REQUEST} \s/+[^?\s]+\.html(?:[?\s]) [NC]
RewriteRule ^(.+)\.html$ /$1 [R=302,L]

# Retira a barra final dos endereços de páginas (/sobre/ → /sobre)
RewriteCond %{THE_REQUEST} \s/+[^/?\s]+/(?:[?\s]) [NC]
RewriteCond %{DOCUMENT_ROOT}/site/$1.html -f
RewriteRule ^([^/.]+)/$ /$1 [R=302,L]

# Evita repetir as regras nos arquivos internos
RewriteRule ^site(?:/|$) - [L]

# Carrega a página inicial
RewriteRule ^$ site/index.html [L]

# Carrega páginas com endereço sem extensão
RewriteCond %{DOCUMENT_ROOT}/site/$1.html -f
RewriteRule ^([^/.]+)/?$ site/$1.html [L]

# Carrega imagens, estilos, scripts e demais arquivos
RewriteRule ^(.+)$ site/$1 [L]
